{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vyshe-neba.local/schemas/production-guard-source-review.schema.json",
  "title": "Vyshe Neba production-guard exact-source review",
  "type": "object",
  "required": ["schema_version","spec_file","generation_id","source","global_gates","specimens","reviewer","review_method","final_verdict","rejection_reasons"],
  "properties": {
    "schema_version": {"const":1},
    "spec_file": {"type":"string","minLength":1},
    "generation_id": {"type":"string","minLength":1},
    "source": {"type":"object"},
    "global_gates": {"type":"object"},
    "specimens": {"type":"array","minItems":1,"maxItems":8},
    "reviewer": {"type":"string","minLength":1},
    "review_method": {"type":"string","minLength":1},
    "final_verdict": {"enum":["pass","fail","pending"]},
    "rejection_reasons": {"type":"array","items":{"type":"string"}}
  }
}
