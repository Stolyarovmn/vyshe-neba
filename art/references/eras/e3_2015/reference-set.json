  "transition_from_e2": [
    {
      "role": "materials-construction",
      "physical_replacement": "Layered composite sections, bonded joints, flush panel latches and sealed service interfaces follow E2 fastened sheet stock, bolted angle joints and exposed service grilles."
    },
    {
      "role": "mechanics-infrastructure",
      "physical_replacement": "Enclosed precision drives, protected cable carriers, dry-break couplings and blind-mate interfaces follow E2 finned servos, exposed actuator assemblies and separate wired connectors."
    },
    {
      "role": "controls-displays",
      "physical_replacement": "Shallow gasketed operator modules and flat digital instrument packages follow E2 deeper rack hardware, CRT housings and taller separately mounted controls."
    },
    {
      "role": "lighting-signals",
      "physical_replacement": "Planar LED cartridges, replaceable emitter modules and molded passive light guides follow E2 deeper fixtures, individual pilot lamps and discrete multi-lamp housings."
    }
  ],
