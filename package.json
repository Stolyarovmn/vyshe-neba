{
  "name": "vyshe-neba",
  "version": "0.1.0",
  "private": true,
  "description": "Выше неба — пиксельная игра про ракету и развитие космодрома",
  "scripts": {
    "build": "node outputs/rocket/build.cjs",
    "test": "node outputs/rocket/verify.cjs",
    "game:build": "node game/tools/build.mjs",
    "game:test": "node --test \"game/test/**/*.test.mjs\" && node game/test/browser.cjs",
    "game:dev": "python -m http.server 8800 --bind 127.0.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.62.1"
  }
}
