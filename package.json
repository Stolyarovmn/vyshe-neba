    "balance": "node game/tools/economy-bot.mjs",
    "balance:quick": "node game/tools/economy-bot.mjs --quick"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
